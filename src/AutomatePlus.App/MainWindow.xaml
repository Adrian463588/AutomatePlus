<Window
    x:Class="AutomatePlus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AutomatePlus.App"
    mc:Ignorable="d"
    Title="AutomatePlus">
    <Grid x:Name="ContentRoot" Padding="20" RowSpacing="12">
        <Grid.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style TargetType="NumberBox">
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="48" />
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="AutomatePlus" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Offline low-code multiplatform test automation" Opacity="0.7" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="Native acceptance requires verified local packs"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="250"
                       Opacity="0.7"
                       AutomationProperties.Name="Native acceptance boundary" />
        </Grid>

        <NavigationView x:Name="MainNavigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        MenuItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                        AutomationProperties.Name="AutomatePlus navigation">
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="local:ShellNavigationItem">
                    <TextBlock Text="{x:Bind DisplayName}" />
                </DataTemplate>
            </NavigationView.MenuItemTemplate>
            <NavigationView.Content>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Workspace content">
                    <StackPanel x:Name="WorkspaceStack" Spacing="12" Padding="4">
                        <StackPanel x:Name="GeneralWorkspace"
                                    Spacing="12"
                                    Visibility="{Binding GeneralWorkspaceVisibility}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Session workspace" FontSize="20" FontWeight="SemiBold" />
                            <ComboBox Header="Platform"
                                      ItemsSource="{Binding Platforms}"
                                      SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Select automation platform" />
                            <TextBlock Text="Select a platform to load its registered capabilities."
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       AutomationProperties.Name="Platform selection guidance" />
                            <ComboBox Header="Framework and language"
                                      ItemsSource="{Binding FrameworkCapabilities}"
                                      SelectedItem="{Binding SelectedCapability, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Select framework and language capability" />
                            <TextBlock Text="Select a capability from the loaded manifest before checking runtime readiness."
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       AutomationProperties.Name="Capability selection guidance" />
                            <TextBlock Text="{Binding CapabilityStateMessage}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       AutomationProperties.Name="Capability state explanation" />
                            <StackPanel x:Name="SelectionActions" Orientation="Horizontal" Spacing="8">
                                <Button Content="Check runtime"
                                        Command="{Binding RefreshRuntimeCommand}"
                                        ToolTipService.ToolTip="Check the selected capability against a local verified runtime pack."
                                        AutomationProperties.Name="Check selected runtime" />
                                <Button Content="Start recorder"
                                        Command="{Binding StartRecordingCommand}"
                                        ToolTipService.ToolTip="{Binding RecorderCommandReason}"
                                        AutomationProperties.Name="Start recorder" />
                                <Button Content="Stop"
                                        Command="{Binding StopCommand}"
                                        ToolTipService.ToolTip="Cancel the active application operation."
                                        AutomationProperties.Name="Stop active operation" />
                            </StackPanel>
                            <TextBlock Text="{Binding RecorderCommandReason}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       AutomationProperties.Name="Recorder command state" />
                        </StackPanel>

                        <Grid x:Name="BodyGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="TimelinePanel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Action timeline" FontSize="20" />
                                    <TextBlock Text="{Binding TimelineStatus}"
                                               TextWrapping="Wrap"
                                               Opacity="0.7"
                                               AutomationProperties.Name="Timeline state" />
                                    <ListView ItemsSource="{Binding Timeline}"
                                              AutomationProperties.Name="Persisted action timeline">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:ShellTimelineItem">
                                                <StackPanel Spacing="2" Padding="4">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.8" />
                                                    <TextBlock Text="{x:Bind LocatorSummary}" Opacity="0.7" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CodePanel"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Generated project preview" FontSize="20" />
                                    <TextBlock Text="Generated output is shown only after the application generator succeeds."
                                               TextWrapping="Wrap"
                                               Opacity="0.7" />
                                    <TextBox Text="{Binding GeneratedCode}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             MinHeight="180"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Generated project preview" />
                                    <Button Content="Generate project"
                                            Command="{Binding GenerateCommand}"
                                            ToolTipService.ToolTip="{Binding GenerateCommandReason}"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="Generate project" />
                                    <TextBlock Text="{Binding GenerateCommandReason}"
                                               TextWrapping="Wrap"
                                               Opacity="0.7"
                                               AutomationProperties.Name="Generate command state" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Session" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SessionState}" />
                                    <TextBlock Text="{Binding SessionStateMessage}" TextWrapping="Wrap" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Runtime" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RuntimeState}" />
                                    <TextBlock Text="{Binding RuntimeStateMessage}" TextWrapping="Wrap" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Workspace" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WorkspaceState}" />
                                    <TextBlock Text="{Binding WorkspaceStateMessage}" TextWrapping="Wrap" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <InfoBar IsOpen="True"
                                 Severity="Warning"
                                 Title="{Binding ActivityState}"
                                 Message="{Binding ActivityMessage}"
                                 AutomationProperties.Name="Live shell status"
                                 AutomationProperties.LiveSetting="Polite" />

                        <StackPanel x:Name="RunActions" Orientation="Horizontal" Spacing="8">
                            <Button Content="Run session"
                                    Command="{Binding RunCommand}"
                                    ToolTipService.ToolTip="{Binding RunCommandReason}"
                                    AutomationProperties.Name="Run current session" />
                            <TextBlock Text="{Binding RunCommandReason}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       AutomationProperties.Name="Run command state" />
                        </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="DeviceFarmWorkspace"
                                    Spacing="12"
                                    Visibility="{Binding AndroidFarmWorkspaceVisibility}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Android Device Farm" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Offline, host-owned replay and primary/follower recording"
                                               TextWrapping="Wrap"
                                               Opacity="0.7" />
                                </StackPanel>
                                <ProgressRing Grid.Column="1"
                                              IsActive="{Binding FarmIsBusy}"
                                              Width="32"
                                              Height="32"
                                              AutomationProperties.Name="Device Farm operation in progress" />
                            </Grid>

                            <InfoBar IsOpen="True"
                                     Severity="Warning"
                                     Title="{Binding FarmStatus}"
                                     Message="{Binding FarmActivityMessage}"
                                     AutomationProperties.Name="Device Farm live status"
                                     AutomationProperties.LiveSetting="Polite" />

                            <Grid x:Name="FarmPanelsGrid" ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="DevicePoolPanel"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Device pool" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FarmDiscoveryMessage}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"
                                                   AutomationProperties.Name="Device discovery status" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Refresh devices"
                                                    Command="{Binding DiscoverDevicesCommand}"
                                                    ToolTipService.ToolTip="Discover devices through the native host; an empty response remains blocked."
                                                    AutomationProperties.Name="Refresh Android devices" />
                                            <Button Content="Clear selection"
                                                    Command="{Binding ClearFarmSelectionCommand}"
                                                    ToolTipService.ToolTip="Clear transient device selection without changing persisted device data."
                                                    AutomationProperties.Name="Clear selected Android devices" />
                                        </StackPanel>
                                        <ComboBox Header="Persisted device group"
                                                  ItemsSource="{Binding FarmGroups}"
                                                  SelectedItem="{Binding SelectedFarmGroup, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Select persisted Android device group" />
                                        <TextBox Header="Device group name"
                                                 Text="{Binding FarmGroupName, Mode=TwoWay}"
                                                 PlaceholderText="Enter a name for the selected devices"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="Android device group name" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Save group"
                                                    Command="{Binding SaveFarmGroupCommand}"
                                                    ToolTipService.ToolTip="{Binding FarmGroupCommandReason}"
                                                    AutomationProperties.Name="Save Android device group" />
                                            <TextBlock Text="{Binding FarmGroupCommandReason}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Opacity="0.7"
                                                       AutomationProperties.Name="Device group command state" />
                                        </StackPanel>
                                        <TextBlock Text="Groups are supplied by the host. No group is invented when storage is unavailable."
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7" />
                                        <ListView ItemsSource="{Binding FarmDevices}"
                                                  SelectionMode="None"
                                                  MaxHeight="360"
                                                  AutomationProperties.Name="Discovered Android device pool">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:FarmDeviceItem">
                                                    <Grid Padding="8" ColumnSpacing="8" RowSpacing="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Row="0"
                                                                  Grid.Column="0"
                                                                  Content="{x:Bind DisplayName}"
                                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                  AutomationProperties.Name="Select Android device" />
                                                        <RadioButton Grid.Row="0"
                                                                     Grid.Column="1"
                                                                     Content="Primary"
                                                                     GroupName="FarmPrimaryDevice"
                                                                     IsChecked="{x:Bind IsPrimary, Mode=TwoWay}"
                                                                     IsEnabled="{x:Bind IsSelected, Mode=OneWay}"
                                                                     AutomationProperties.Name="Use device as primary recorder" />
                                                        <CheckBox Grid.Row="0"
                                                                  Grid.Column="2"
                                                                  Content="Follower"
                                                                  IsChecked="{x:Bind IsFollower, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind IsSelected, Mode=OneWay}"
                                                                  AutomationProperties.Name="Use device as follower validator" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.Column="0"
                                                                   Grid.ColumnSpan="3"
                                                                   Text="{x:Bind SerialSummary}"
                                                                   TextWrapping="Wrap"
                                                                   Opacity="0.8" />
                                                        <TextBlock Grid.Row="2"
                                                                   Grid.Column="0"
                                                                   Grid.ColumnSpan="3"
                                                                   Text="{x:Bind DeviceDetails}"
                                                                   TextWrapping="Wrap"
                                                                   Opacity="0.7" />
                                                        <TextBlock Grid.Row="3"
                                                                   Grid.Column="0"
                                                                   Text="{x:Bind StatusSummary}"
                                                                   TextWrapping="Wrap"
                                                                   Opacity="0.7" />
                                                        <TextBlock Grid.Row="3"
                                                                   Grid.Column="1"
                                                                   Grid.ColumnSpan="2"
                                                                   Text="{x:Bind EvidenceSummary, Mode=OneWay}"
                                                                   TextWrapping="Wrap"
                                                                   Opacity="0.7" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock Text="{Binding FarmSelectionSummary}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Device selection summary" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="FarmRunPanel"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Replay strategy" FontSize="20" FontWeight="SemiBold" />
                                        <ComboBox Header="Execution strategy"
                                                  ItemsSource="{Binding FarmStrategies}"
                                                  SelectedItem="{Binding SelectedFarmStrategy, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Select Device Farm replay strategy" />
                                        <TextBlock Text="{Binding SelectedFarmStrategy.Description}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7" />
                                        <NumberBox Header="Iterations"
                                                   Value="{Binding FarmIterations, Mode=TwoWay}"
                                                   Minimum="1"
                                                   Maximum="100000"
                                                   SmallChange="1"
                                                   HorizontalAlignment="Stretch"
                                                   AutomationProperties.Name="Farm iteration count" />
                                        <NumberBox Header="Maximum parallel devices"
                                                   Value="{Binding FarmMaxParallelDevices, Mode=TwoWay}"
                                                   Minimum="1"
                                                   Maximum="1000"
                                                   SmallChange="1"
                                                   HorizontalAlignment="Stretch"
                                                   AutomationProperties.Name="Maximum parallel device count" />
                                        <NumberBox Header="Delay between iterations (seconds)"
                                                   Value="{Binding FarmIterationDelaySeconds, Mode=TwoWay}"
                                                   Minimum="0"
                                                   Maximum="86400"
                                                   SmallChange="1"
                                                   HorizontalAlignment="Stretch"
                                                   AutomationProperties.Name="Farm iteration delay" />
                                        <ComboBox Header="Failure policy"
                                                  ItemsSource="{Binding FarmFailurePolicies}"
                                                  SelectedItem="{Binding SelectedFarmFailurePolicy, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Select Device Farm failure policy" />
                                        <TextBlock Text="{Binding SelectedFarmFailurePolicy.Description}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Run farm"
                                                    Command="{Binding StartFarmRunCommand}"
                                                    ToolTipService.ToolTip="{Binding FarmRunCommandReason}"
                                                    AutomationProperties.Name="Run Android Device Farm" />
                                            <Button Content="Cancel"
                                                    Command="{Binding StopCommand}"
                                                    ToolTipService.ToolTip="Request cancellation and let the host release processes, ports, and leases."
                                                    AutomationProperties.Name="Cancel Device Farm operation" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FarmRunCommandReason}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"
                                                   AutomationProperties.Name="Device Farm replay command state" />
                                        <TextBlock Text="{Binding FarmCancellationMessage}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"
                                                   AutomationProperties.Name="Device Farm cancellation state" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="FarmRecordingPanel"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Primary/follower recording" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="Only primary actions become canonical ActionIR. Followers produce independent locator observations."
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7" />
                                        <TextBlock Text="{Binding PrimaryFollowerSummary}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Primary and follower selection summary" />
                                        <Button Content="Start primary + follower recording"
                                                Command="{Binding StartPrimaryFollowerRecordingCommand}"
                                                ToolTipService.ToolTip="{Binding FarmRecordingCommandReason}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="Start primary and follower recording" />
                                        <TextBlock Text="{Binding FarmRecordingCommandReason}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"
                                                   AutomationProperties.Name="Primary and follower recording command state" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="FarmEvidencePanel"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        Padding="16">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Run evidence" FontSize="20" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="12" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Status" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding FarmStatus}" />
                                            <TextBlock Grid.Row="1" Text="Completion" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FarmCompletion}" />
                                        </Grid>
                                        <TextBlock Text="{Binding FarmEvidenceSummary}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Farm evidence summary" />
                                        <ListView ItemsSource="{Binding FarmObservations}"
                                                  MaxHeight="260"
                                                  AutomationProperties.Name="Follower observation evidence">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:FarmObservationItem">
                                                    <StackPanel Spacing="2" Padding="6">
                                                        <TextBlock Text="{x:Bind DeviceSummary}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind StatusSummary}" />
                                                        <TextBlock Text="{x:Bind LocatorSummary}"
                                                                   TextWrapping="Wrap"
                                                                   Opacity="0.8" />
                                                        <TextBlock Text="{x:Bind Details}"
                                                                   TextWrapping="Wrap"
                                                                   Opacity="0.7" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </NavigationView.Content>
        </NavigationView>

        <TextBlock Grid.Row="2"
                   Text="{Binding RuntimeStateMessage}"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   AutomationProperties.Name="Native runtime acceptance status" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="12" />
                        <Setter Target="MainNavigation.DisplayMode" Value="Compact" />
                        <Setter Target="SelectionActions.Orientation" Value="Vertical" />
                        <Setter Target="RunActions.Orientation" Value="Vertical" />
                        <Setter Target="TimelinePanel.(Grid.Column)" Value="0" />
                        <Setter Target="TimelinePanel.(Grid.Row)" Value="0" />
                        <Setter Target="CodePanel.(Grid.Column)" Value="0" />
                        <Setter Target="CodePanel.(Grid.Row)" Value="1" />
                        <Setter Target="FarmRunPanel.(Grid.Column)" Value="0" />
                        <Setter Target="FarmRunPanel.(Grid.Row)" Value="1" />
                        <Setter Target="FarmRecordingPanel.(Grid.Column)" Value="0" />
                        <Setter Target="FarmRecordingPanel.(Grid.Row)" Value="2" />
                        <Setter Target="FarmEvidencePanel.(Grid.Column)" Value="0" />
                        <Setter Target="FarmEvidencePanel.(Grid.Row)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Expanded">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="20" />
                        <Setter Target="MainNavigation.DisplayMode" Value="Expanded" />
                        <Setter Target="SelectionActions.Orientation" Value="Horizontal" />
                        <Setter Target="RunActions.Orientation" Value="Horizontal" />
                        <Setter Target="TimelinePanel.(Grid.Column)" Value="0" />
                        <Setter Target="TimelinePanel.(Grid.Row)" Value="0" />
                        <Setter Target="CodePanel.(Grid.Column)" Value="1" />
                        <Setter Target="CodePanel.(Grid.Row)" Value="0" />
                        <Setter Target="FarmRunPanel.(Grid.Column)" Value="1" />
                        <Setter Target="FarmRunPanel.(Grid.Row)" Value="0" />
                        <Setter Target="FarmRecordingPanel.(Grid.Column)" Value="0" />
                        <Setter Target="FarmRecordingPanel.(Grid.Row)" Value="1" />
                        <Setter Target="FarmEvidencePanel.(Grid.Column)" Value="1" />
                        <Setter Target="FarmEvidencePanel.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
