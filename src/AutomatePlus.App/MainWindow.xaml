<Window
    x:Class="AutomatePlus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AutomatePlus">
    <Grid Padding="24" RowSpacing="16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="AutomatePlus" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Offline low-code multiplatform test automation" Opacity="0.7" />
        </StackPanel>

        <NavigationView Grid.Row="1" Grid.Column="0" IsBackButtonVisible="Collapsed" IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Projects" />
                <NavigationViewItem Content="Web recorder" />
                <NavigationViewItem Content="Android recorder" />
                <NavigationViewItem Content="API builder" />
                <NavigationViewItem Content="Runs and reports" />
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox Header="Platform" SelectedIndex="0" Width="150">
                    <ComboBoxItem Content="Web" />
                    <ComboBoxItem Content="Android" />
                    <ComboBoxItem Content="API" />
                </ComboBox>
                <ComboBox Header="Framework" SelectedIndex="0" Width="180">
                    <ComboBoxItem Content="Playwright" />
                    <ComboBoxItem Content="Appium" />
                    <ComboBoxItem Content="k6" />
                </ComboBox>
                <Button Content="Start recorder" VerticalAlignment="Bottom" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Action timeline" FontSize="20" />
                        <TextBlock Text="Record an action or drag a step here to compose the session." Opacity="0.7" />
                        <ListView>
                            <ListViewItem Content="1. Navigate" />
                            <ListViewItem Content="2. Click" />
                            <ListViewItem Content="3. Assert" />
                        </ListView>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Code preview" FontSize="20" />
                        <TextBlock Text="Generated code appears after capability validation." Opacity="0.7" TextWrapping="Wrap" />
                        <TextBox Text="// Select a session to generate a runnable project" IsReadOnly="True" AcceptsReturn="True" Height="120" />
                    </StackPanel>
                </Border>
            </Grid>
            <InfoBar Grid.Row="2" IsOpen="True" Severity="Warning" Title="Runtime health" Message="Import a verified offline runtime pack before recording or running." />
        </Grid>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="State: Draft · Missing runtimes remain Blocked and never simulate a pass." Opacity="0.7" />
    </Grid>
</Window>
