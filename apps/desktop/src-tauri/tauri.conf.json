{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutomatePlus",
  "version": "1.0.0",
  "identifier": "com.automateplus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@automate-plus/desktop -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutomatePlus",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/sidecar/**/*",
      "resources/node/**/*",
      "resources/runtime-packs/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
