{
  "name": "automate-plus",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-First Multiplatform Test Automation & Code Generation Platform",
  "author": "AutomatePlus Core Team",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:desktop": "npm --prefix frontend run dev",
    "build:packages": "npm --prefix frontend run build:packages",
    "build:desktop": "npm --prefix frontend run build:desktop",
    "build:sidecar": "npm --prefix frontend run build:sidecar",
    "verify:k6": "node scripts/verify-k6-online.mjs",
    "verify:k6:fixture": "npm run build:packages && node scripts/verify-k6-fixture.mjs",
    "verify:generators": "npm run build:packages && node scripts/verify-generators.mjs",
    "verify:runtime-catalog": "node scripts/verify-runtime-catalog.mjs --require-ready",
    "verify:runtime-manager": "node scripts/verify-runtime-manager.mjs",
    "verify:offline-install": "node scripts/verify-offline-install.mjs",
    "verify:release-manifest": "node scripts/verify-release-manifest.mjs",
    "verify:ui-contract": "node scripts/verify-ui-contract.mjs",
    "verify:anti-slop": "node scripts/verify-anti-slop.mjs",
    "e2e:online": "node scripts/verify-online-e2e.mjs",
    "e2e:android": "node scripts/verify-android-e2e.mjs",
    "verify:sidecar": "npm run build:packages && npm run build:sidecar && node scripts/verify-sidecar.mjs",
    "verify:docs": "node scripts/verify-markdown.mjs",
    "verify:authenticity": "node scripts/verify-authenticity.mjs",
    "build": "npm run build:packages && npm run build:sidecar && npm run build:desktop",
    "test": "npm --prefix frontend run test",
    "typecheck": "npm --prefix frontend run typecheck",
    "typecheck:packages": "npm --prefix frontend run typecheck:packages",
    "typecheck:desktop": "npm --prefix frontend run typecheck:desktop",
    "typecheck:sidecar": "npm --prefix frontend run typecheck:sidecar",
    "lint": "node scripts/quality-check.mjs lint",
    "format:check": "node scripts/quality-check.mjs format:check",
    "format": "node scripts/quality-check.mjs format:check",
    "native:preflight": "node scripts/build-native-offline.mjs --preflight",
    "native:check": "node scripts/build-native-offline.mjs --check",
    "native:build": "node scripts/build-native-offline.mjs --build",
    "native:run": "Run-AutomatePlus.bat"
  },
  "dependencies": {
    "@automate-plus/contracts": "file:frontend/packages/contracts",
    "@automate-plus/generators": "file:frontend/packages/generators",
    "@automate-plus/ir-schema": "file:frontend/packages/ir-schema",
    "@automate-plus/persistence": "file:frontend/packages/persistence",
    "@automate-plus/recorder-android": "file:frontend/packages/recorder-android",
    "@automate-plus/recorder-web": "file:frontend/packages/recorder-web",
    "@automate-plus/runner-core": "file:frontend/packages/runner-core",
    "@automate-plus/selector-engine": "file:frontend/packages/selector-engine",
    "@automate-plus/stress-engine": "file:frontend/packages/stress-engine",
    "@automate-plus/desktop": "file:frontend",
    "@automate-plus/sidecar": "file:frontend/sidecar",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
